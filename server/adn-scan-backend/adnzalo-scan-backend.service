[Unit]
Description=ADNzalo Zalo scan backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adnzalo-scan
Group=adnzalo-scan
WorkingDirectory=/home/adncapital/app/adnzalo-scan-backend
EnvironmentFile=/home/adncapital/app/adnzalo-scan-backend/.env
ExecStart=/usr/bin/node /home/adncapital/app/adnzalo-scan-backend/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Kho thành viên tích lũy (data/member-cache.json) phải ghi được dù ProtectHome=read-only.
# Tiền tố '-' để service vẫn start nếu thư mục chưa tồn tại (deploy-vps.sh sẽ tạo sẵn).
ReadWritePaths=-/home/adncapital/app/adnzalo-scan-backend/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
